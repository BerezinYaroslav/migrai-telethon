# PostgreSQL (async SQLAlchemy URL)
DATABASE_URL=postgresql+asyncpg://migrai:migrai@localhost:5432/migrai

# Telegram MTProto. Fill these after creating the separate research account.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=var/sessions/migrai-research
TELEGRAM_FLOOD_SLEEP_THRESHOLD_SECONDS=60

# Scan limits
SCAN_HISTORY_LIMIT=500
SCAN_INCREMENTAL_LIMIT=2000
SCAN_WAIT_TIME_SECONDS=1.0
SIGNAL_SCORE_THRESHOLD=5
CANDIDATE_EXPORT_MIN_SCORE=5
SIGNAL_EXCERPT_MAX_CHARS=500
COMMENTS_ENABLED=true
COMMENTS_POST_MIN_SCORE=5
COMMENTS_LIMIT_PER_POST=200
REACTIONS_ENABLED=true
REACTION_SIGNAL_SCORE=1
REACTION_POST_MIN_SCORE=5
REACTION_USERS_LIMIT=100

# Google Sheets (optional until a spreadsheet and service account are ready)
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SOURCES_RANGE='Каналы и чаты'!A:Z
GOOGLE_CANDIDATES_RANGE='Потенциальные респонденты'!A:L
SHEETS_SOURCE_NAME_COLUMN=Название
SHEETS_SOURCE_TYPE_COLUMN=Тип
SHEETS_SOURCE_URL_COLUMN=Ссылка
SHEETS_SOURCE_STATUS_COLUMN=Статус
SHEETS_DISABLED_STATUSES=Забанен,Отключен,Не использовать

LOG_LEVEL=INFO
